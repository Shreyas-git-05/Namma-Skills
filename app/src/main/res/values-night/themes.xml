<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.NammaSkill" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- PRIMARY COLORS -->

        <item name="colorPrimary">@color/namma_primary</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- SECONDARY COLORS -->

        <item name="colorSecondary">@color/namma_secondary</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- BACKGROUND -->

        <item name="android:windowBackground">@color/background</item>

        <!-- SURFACE -->

        <item name="colorSurface">@color/surface</item>

        <!-- STATUS BAR -->

        <item name="android:statusBarColor"
            tools:targetApi="l">@android:color/transparent</item>

        <!-- NAVIGATION BAR -->

        <item name="android:navigationBarColor"
            tools:targetApi="l">@color/background</item>

        <!-- RIPPLE -->

        <item name="colorControlHighlight">@color/namma_primary_light</item>

        <!-- BUTTON STYLE -->

        <item name="materialButtonStyle">
            @style/Widget.Material3.Button
        </item>

        <!-- CARD STYLE -->

        <item name="materialCardViewStyle">
            @style/Widget.Material3.CardView.Elevated
        </item>

    </style>

</resources>